# ReTool Mobile — configuração do Firebase
#
# 1. Copie este arquivo para `.env` (na mesma pasta: retoolapp/.env).
# 2. Preencha com as chaves do app WEB do Firebase — são as mesmas variáveis
#    do ReTool desktop, então dá para copiar o `.env` de lá sem alterar nada.
#    Onde achar: Console do Firebase > Configurações do projeto > Seus apps > App da Web > "SDK setup and configuration" (Config).
# 3. O `.env` não vai para o git (está no .gitignore). Nunca comite as chaves.

# Banco usado: false = principal, true = banco de contingência (FALLBACK abaixo)
VITE_USE_FALLBACK_DB=false

# Banco Principal
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Banco Fallback (opcional)
VITE_FIREBASE_FALLBACK_API_KEY=
VITE_FIREBASE_FALLBACK_AUTH_DOMAIN=
VITE_FIREBASE_FALLBACK_PROJECT_ID=
VITE_FIREBASE_FALLBACK_STORAGE_BUCKET=
VITE_FIREBASE_FALLBACK_MESSAGING_SENDER_ID=
VITE_FIREBASE_FALLBACK_APP_ID=
VITE_FIREBASE_FALLBACK_MEASUREMENT_ID=

# Emuladores locais do Firebase (opcional; `npm run emuladores` no ReTool desktop).
# No emulador do Android Studio, 10.0.2.2 é o seu computador.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=10.0.2.2
